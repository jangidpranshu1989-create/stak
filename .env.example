# Engines (at least one). Stak picks the best one automatically per request.
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
# Database — Postgres (Neon / Vercel Postgres). Without it Stak uses SQLite (local) or /tmp (serverless, not persistent).
DATABASE_URL=
# Long random string used to encrypt project secrets and sign sessions
STAK_SECRET=
# Optional
STAK_PUBLIC_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
STAK_ADMIN_TOKEN=
GROQ_TPM=
