# ---- AI providers (at least one) ----
GROQ_API_KEY=
NVIDIA_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any OpenAI-compatible endpoint (Together, OpenRouter, Ollama, vLLM…)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=model-a,model-b
# OPENAI_COMPAT_LABEL=My provider

# ---- Server ----
PORT=5000
# 32+ random chars. Encrypts saved API keys (AES-256-GCM). If unset, a random key is generated and stored in the DB.
STAK_SECRET=
STAK_DATA_DIR=./data
# STAK_PUBLIC_URL=https://stak.example.com
# Set to 1 behind a reverse proxy (Render, Fly, Nginx) so rate limits see real IPs
STAK_TRUST_PROXY=0
STAK_SESSION_DAYS=30
STAK_MAX_JOBS=4
# Use HTTPS_PROXY/HTTP_PROXY for outbound model calls
# STAK_EGRESS_PROXY=1

# ---- Engine ----
STAK_REPAIR_ROUNDS=2
# Override model fallback chains (comma-separated provider:model)
# STAK_CHAIN_BUILD=groq:openai/gpt-oss-120b,nvidia:nvidia/nemotron-3-ultra-550b-a55b
# STAK_CHAIN_PLAN=
# STAK_CHAIN_FAST=

# ---- Photos (Wikimedia Commons, free licences with credits) ----
STAK_PHOTOS=1
STAK_PHOTOS_PER_BUILD=6

# ---- Quotas (per day / per minute) ----
# STAK_GUEST_PROJ_DAY=10
# STAK_GUEST_AI_DAY=200
# STAK_GUEST_AI_MIN=20
# STAK_USER_PROJ_DAY=50
# STAK_USER_AI_DAY=2000
# STAK_USER_AI_MIN=60

# ---- Live web search (optional; falls back to keyless DuckDuckGo + Wikipedia) ----
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# STAK_FREE_SEARCH=1
