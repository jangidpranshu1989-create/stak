<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="@drawable/w_bg" android:padding="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_logo" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Stak" android:textColor="#A1A1AA" android:textSize="12sp" />
  </LinearLayout>
  <TextView android:id="@+id/big" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="#F4F4F5" android:textSize="30sp" android:textStyle="bold" />
  <TextView android:id="@+id/bigLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="questions waiting" android:textColor="#FF7A18" android:textSize="12sp" />
  <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="#D4D4D8" android:textSize="12sp" />
  <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="#A1A1AA" android:textSize="12sp" />
  <TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#71717A" android:textSize="11sp" />
</LinearLayout>
