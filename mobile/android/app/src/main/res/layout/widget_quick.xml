<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">

    <LinearLayout android:id="@+id/q_input" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
        android:background="@drawable/widget_pill" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="6dp" android:paddingEnd="12dp" android:contentDescription="Describe an app">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_btn_brand"
            android:padding="7dp" android:src="@drawable/ic_w_plus" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp"
            android:ellipsize="end" android:maxLines="1" android:text="Describe an app…" android:textColor="#B3FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <ImageView android:id="@+id/q_bot" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_round" android:padding="10dp" android:src="@drawable/ic_w_bot" android:contentDescription="Build a chatbot" />
    <ImageView android:id="@+id/q_chart" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp"
        android:background="@drawable/widget_round" android:padding="10dp" android:src="@drawable/ic_w_chart" android:contentDescription="Build a tracker" />
    <ImageView android:id="@+id/q_game" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp"
        android:background="@drawable/widget_round" android:padding="10dp" android:src="@drawable/ic_w_game" android:contentDescription="Build a game" />
</LinearLayout>
