<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/p_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="2dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_logo" android:importantForAccessibility="no" />
        <TextView android:id="@+id/p_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium" android:text="Projects" android:textColor="#FFF6F2EE" android:textSize="14sp" />
        <TextView android:id="@+id/p_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:text="" android:textColor="#99FFFFFF" android:textSize="11sp" />
        <ImageView android:id="@+id/p_new" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_btn_brand"
            android:padding="7dp" android:src="@drawable/ic_w_plus" android:contentDescription="New app" />
    </LinearLayout>

    <ListView android:id="@+id/p_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:divider="@android:color/transparent" android:dividerHeight="5dp" android:scrollbars="none" />

    <TextView android:id="@+id/p_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="No projects yet — tap + to build one" android:textColor="#99FFFFFF" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
